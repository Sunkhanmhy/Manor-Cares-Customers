# Supabase project connection (safe to expose in the browser — anon/public key only).
# Never put a service_role key or DB password in this app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Separate public metrics Supabase project (NOT the customer/users database).
VITE_METRICS_SUPABASE_URL=https://your-metrics-project-ref.supabase.co
VITE_METRICS_SUPABASE_ANON_KEY=your-metrics-public-anon-key
